---
import { siteConfig } from "../config";
const hasCertifications =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Certifications
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-8">
              {siteConfig.certifications.map((cert) => (
                <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 md:p-6 hover:shadow-md transition-shadow duration-300">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                    <div>
                      <h3 class="text-lg sm:text-xl font-semibold text-gray-900">
                        {cert.name}
                      </h3>
                      <p
                        class="text-base sm:text-lg"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        {cert.issuer}
                      </p>
                    </div>
                    <span class="text-xs sm:text-sm text-gray-500 shrink-0">
                      {cert.date}
                    </span>
                  </div>

                  <div class="flex flex-wrap items-center justify-between gap-4">
                    {cert.skills && cert.skills.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 sm:gap-2">
                        {cert.skills.map((skill) => (
                          <span class="px-2.5 sm:px-3 py-1 sm:py-1.5 bg-gray-100 text-gray-800 rounded-md sm:rounded-lg text-xs sm:text-sm font-medium">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}
                    {cert.link && (
                      <a
                        href={cert.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm sm:text-base font-medium hover:underline"
                        style={`color: ${siteConfig.accentColor}`}
                      >
                        View credential →
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
