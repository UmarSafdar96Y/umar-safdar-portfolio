---
import { siteConfig } from "../config";
import { withBase } from "../lib/site";
const apps = siteConfig.apps;
const hasApps = apps?.items && apps.items.length > 0;
---

{
  hasApps && (
    <section id="apps" class="p-8 sm:p-12 md:p-16 lg:p-24">
      <div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
          <div class="lg:col-span-4">
            <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900">
              Apps
            </h2>
            <div
              class="w-[75px] h-[5px] mt-2 rounded-full"
              style={`background-color: ${siteConfig.accentColor}`}
            />
          </div>

          <div class="lg:col-span-8 space-y-8">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
              <p class="text-lg sm:text-xl text-gray-600 leading-relaxed">
                {apps.intro}
              </p>
              {apps.allAppsLink && (
                <a
                  href={apps.allAppsLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 text-sm sm:text-base font-medium hover:underline"
                  style={`color: ${siteConfig.accentColor}`}
                >
                  View all on the App Store →
                </a>
              )}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              {apps.items.map((app) => (
                <a
                  href={app.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col p-4 sm:p-6 bg-gray-50 rounded-xl sm:rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-xl hover:border-gray-300 hover:-translate-y-1"
                >
                  <div class="flex items-center gap-4">
                    <img
                      src={withBase(app.icon)}
                      alt={`${app.name} app icon`}
                      width="64"
                      height="64"
                      loading="lazy"
                      class="w-14 h-14 sm:w-16 sm:h-16 rounded-[22%] border border-gray-200 shrink-0"
                    />
                    <div>
                      <h3 class="text-lg sm:text-xl font-bold text-gray-900">
                        {app.name}
                      </h3>
                      <p class="text-sm text-gray-500">{app.category}</p>
                    </div>
                  </div>

                  <p class="mt-4 text-sm sm:text-base text-gray-600 leading-relaxed flex-1">
                    {app.description}
                  </p>

                  <span class="mt-5 inline-flex items-center gap-2 self-start px-3 py-1.5 bg-gray-900 text-white rounded-lg text-xs sm:text-sm font-medium transition-colors duration-300 group-hover:bg-gray-700">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M8.286 7.008c-3.216 0 -4.286 3.23 -4.286 5.92c0 3.229 2.143 8.072 4.286 8.072c1.165 -.05 1.799 -.538 3.214 -.538c1.406 0 1.607 .538 3.214 .538s4.286 -3.229 4.286 -5.381c-.03 -.011 -2.649 -.434 -2.679 -3.23c-.02 -2.335 2.589 -3.179 2.679 -3.228c-1.096 -1.606 -3.162 -2.113 -3.75 -2.153c-1.535 -.12 -3.032 1.077 -3.75 1.077c-.729 0 -2.036 -1.077 -3.214 -1.077z" />
                      <path d="M12 4a2 2 0 0 0 2 -2a2 2 0 0 0 -2 2" />
                    </svg>
                    View on the App Store
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
